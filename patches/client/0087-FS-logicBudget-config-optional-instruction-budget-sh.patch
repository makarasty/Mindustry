 tests/src/test/java/ServerLimitsTests.java    | 154 ++++++++++++------
 2 files changed, 116 insertions(+), 49 deletions(-)

diff --git a/core/src/mindustry/world/blocks/logic/LogicBlock.java b/core/src/mindustry/world/blocks/logic/LogicBlock.java
index 7381dc365f4f7b9ef3b426d3912d40a2a90cec5c..cc7d568885bbe18da59e2e78d485ad0e8d9502e2 100644
--- a/core/src/mindustry/world/blocks/logic/LogicBlock.java
+++ b/core/src/mindustry/world/blocks/logic/LogicBlock.java
@@ -587,10 +587,12 @@ public class LogicBlock extends Block{
                 if(accumulator > maxInstructionScale * ipt) accumulator = maxInstructionScale * ipt;
 
                 running = true;
+                boolean waited = false;
                 while(accumulator >= 1f){
                     executor.runOnce();
                     if(executor.yield){
                         executor.yield = false;
+                        waited = true;
                         break;
                     }
                     accumulator --;
@@ -599,7 +601,14 @@ public class LogicBlock extends Block{
 
                 // Do not move in front of the loop, otherwise the curTime accumulated in WaitI
                 // may get out of sync with the accumulator increase.
-                accumulator += edelta() * ipt;
+                float add = edelta() * ipt;
+                //MDTX: optional instruction budget shared by player processors on servers, see ServerLimits
+                if(!privileged && ServerLimits.logicIpt > 0){
+                    //processors in wait or stop do not compete for the budget
+                    if(!waited) ServerLimits.logicDemand += add;
+                    add *= ServerLimits.logicScale;
+                }
+                accumulator += add;
             }
         }
 
