index 0000000000000000000000000000000000000000..939cbcd2450b3a4d2bd50fe1521029cc4624fecd
--- /dev/null
+++ b/tests/src/test/java/SettingsSaveTests.java
@@ -0,0 +1,34 @@
+import arc.*;
+import org.junit.jupiter.api.*;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Putting a value that is already stored must not mark settings for a rewrite of settings.bin. */
+public class SettingsSaveTests{
+
+    @BeforeAll
+    static void init(){
+        ApplicationTests.launchApplication();
+    }
+
+    @Test
+    void unchangedPutIsNotAModification(){
+        //the test app never loads settings, and forceSave() skips unloaded settings
+        Core.settings.load();
+        Core.settings.put("mdtx-test-int", 5);
+        Core.settings.put("mdtx-test-str", "a");
+        Core.settings.forceSave();
+        assertFalse(Core.settings.modified());
+
+        Core.settings.put("mdtx-test-int", 5);
+        Core.settings.put("mdtx-test-str", "a");
+        assertFalse(Core.settings.modified(), "same values");
+
+        Core.settings.put("mdtx-test-int", 6);
+        assertTrue(Core.settings.modified(), "a changed value");
+        Core.settings.forceSave();
+
+        Core.settings.put("mdtx-test-bytes", new byte[]{1});
+        assertTrue(Core.settings.modified(), "byte arrays compare by identity and always count");
+    }
+}
