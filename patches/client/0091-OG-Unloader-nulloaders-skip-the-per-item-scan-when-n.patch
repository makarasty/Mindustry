+++ b/tests/src/test/java/UnloaderSkipTests.java
@@ -0,0 +1,61 @@
+import arc.math.*;
+import mindustry.content.*;
+import mindustry.game.*;
+import mindustry.type.*;
+import mindustry.world.*;
+import mindustry.world.blocks.storage.Unloader.*;
+import org.junit.jupiter.api.*;
+
+import java.lang.reflect.*;
+
+import static mindustry.Vars.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+/** A nulloader skips its per-item scan when no giving neighbour holds anything; that must never hide an item it could move. */
+public class UnloaderSkipTests{
+
+    @BeforeAll
+    static void init(){
+        ApplicationTests.launchApplication();
+    }
+
+    @Test
+    void noItemToGiveMeansNoPossibleItem() throws Exception{
+        Method any = UnloaderBuild.class.getDeclaredMethod("anyItemToGive"), possible = UnloaderBuild.class.getDeclaredMethod("isPossibleItem", Item.class);
+        any.setAccessible(true);
+        possible.setAccessible(true);
+        Block[] around = {Blocks.container, Blocks.container, Blocks.sorter, Blocks.router, Blocks.conveyor, Blocks.junction, Blocks.unloader, Blocks.air};
+        Rand r = new Rand(6);
+        int empty = 0;
+
+        for(int i = 0; i < 400; i++){
+            state.rules = new Rules();
+            Tiles tiles = world.resize(9, 9);
+            world.beginMapLoad();
+            tiles.fill();
+            world.endMapLoad();
+            world.tile(4, 4).setBlock(Blocks.unloader, Team.sharded);
+            //a 2x2 block placed at (x, y) covers x..x+1 and y..y+1, so the left and bottom ones start two tiles away
+            int[][] spots1 = {{5, 4}, {3, 4}, {4, 5}, {4, 3}}, spots2 = {{5, 4}, {2, 4}, {4, 5}, {4, 2}};
+            for(int k = 0; k < 4; k++){
+                Block b = around[r.random(around.length - 1)];
+                int x = b.size == 2 ? spots2[k][0] : spots1[k][0], y = b.size == 2 ? spots2[k][1] : spots1[k][1];
+                world.tile(x, y).setBlock(b, r.chance(0.8) ? Team.sharded : Team.crux, r.random(3));
+                var build = world.build(x, y);
+                if(build != null && build.items != null && r.chance(0.6)){
+                    build.items.add(content.item(r.random(content.items().size - 1)), r.random(1, 5));
+                }
+            }
+            var unloader = (UnloaderBuild)world.build(4, 4);
+            unloader.onProximityUpdate();
+
+            if(!(boolean)any.invoke(unloader)){
+                empty++;
+                for(Item item : content.items()){
+                    assertFalse((boolean)possible.invoke(unloader, item), "setup " + i + " " + item.name);
+                }
+            }
+        }
+        assertTrue(empty > 20, "the test should hit empty neighbourhoods, got " + empty);
+    }
+}
