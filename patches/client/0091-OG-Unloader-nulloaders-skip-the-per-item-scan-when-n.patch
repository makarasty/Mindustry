+        /** MDTX: false when no neighbour that can give holds anything; isPossibleItem is then false for every item (counts are never negative). */
+        private boolean anyItemToGive(){
+            var pbi = possibleBlocks.items;
+            for(int i = 0, l = possibleBlocks.size; i < l; i++){
+                var other = pbi[i].building;
+                if(other.items != null && other.items.total() > 0 && other.canUnload()) return true;
+            }
+            return false;
+        }
