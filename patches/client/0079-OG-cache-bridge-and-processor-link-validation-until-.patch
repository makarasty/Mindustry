@@ -98,6 +98,8 @@ public class LogicBlock extends Block{
             var lbuild = world.build(pos);
             int x = lbuild.tileX(), y = lbuild.tileY();
             int oldSize = entity.links.size;
+            //MDTX: an unlink and a relink in one tick keep links.size, so invalidate explicitly
+            entity.validatedTopology = -1;
 
             entity.links.removeAll(l -> {
                 boolean remove = world.build(l.x, l.y) == lbuild;
@@ -271,6 +273,9 @@ public class LogicBlock extends Block{
         public Seq<LogicLink> links = new Seq<>();
         public @Nullable ObjectIntMap<String> linkMap;
         public boolean checkedDuplicates = false;
+        /** MDTX: {@link Tile#topologyVersion} and link count at the last link validation; see updateTile. */
+        protected long validatedTopology = -1;
+        protected int validatedLinks = -1;
 
         public int ipt = instructionsPerTick;
         /** Display name, for convenience. This is currently only available for world processors. */
@@ -287,6 +292,7 @@ public class LogicBlock extends Block{
         }
 
         public void readCompressed(byte[] data, boolean relative){
+            validatedTopology = -1;
             try(DataInputStream stream = new DataInputStream(new InflaterInputStream(new ByteArrayInputStream(data)))){
                 int version = stream.read();
 
@@ -374,6 +380,7 @@ public class LogicBlock extends Block{
         }
 
         public void updateCode(String str, boolean keep, Cons<LAssembler> assemble){
+            validatedTopology = -1;
             linkMap = null;
             if(str != null){
                 code = str;
@@ -518,7 +525,9 @@ public class LogicBlock extends Block{
             }
 
             //check for previously invalid links to add after configuration
-            boolean changed = false, updates = true;
+            //MDTX: link validity only depends on blocks, teams and the link list, so the per-link world lookups are skipped until one of them changes.
+            //World processors also depend on rules and are always checked.
+            boolean changed = false, updates = privileged || validatedTopology != Tile.topologyVersion || validatedLinks != links.size;
 
             while(updates){
                 updates = false;
@@ -569,6 +578,8 @@ public class LogicBlock extends Block{
             if(changed){
                 updateLinks();
             }
+            validatedTopology = Tile.topologyVersion;
+            validatedLinks = links.size;
 
             if(state.rules.disableWorldProcessors && privileged) return;
 
