Subject: [PATCH] OG(LExecutor): step over noop, and draw on servers, without
 dispatching

---
 core/src/mindustry/logic/LExecutor.java       | 31 +++++++
 .../world/blocks/logic/LogicBlock.java        |  6 ++
 tests/src/test/java/LogicSkipTests.java       | 86 +++++++++++++++++++
 3 files changed, 123 insertions(+)
 create mode 100644 tests/src/test/java/LogicSkipTests.java

diff --git a/core/src/mindustry/logic/LExecutor.java b/core/src/mindustry/logic/LExecutor.java
index 7d1a8e3022ae787b578ec760f7d681a10ceb857f..62175e7ed1848aa534e40c74296a78633e276c0a 100644
--- a/core/src/mindustry/logic/LExecutor.java
+++ b/core/src/mindustry/logic/LExecutor.java
@@ -123,6 +123,37 @@ public class LExecutor{
         }
     }
 
+    //MDTX: per instruction, whether running it changes nothing but the counter: noop, and draw on a headless server
+    private boolean[] noop;
+    private boolean anyNoop;
+    private LInstruction[] noopOf;
+
+    /** MDTX: rebuilds the flags if the instructions changed; false if the program has nothing to skip, then skipNoop() need not be called. */
+    public boolean prepareSkip(){
+        if(noopOf != instructions){
+            noopOf = instructions;
+            noop = new boolean[instructions.length];
+            anyNoop = false;
+            for(int i = 0; i < noop.length; i++){
+                Class<?> type = instructions[i].getClass();
+                anyNoop |= noop[i] = type == NoopI.class || (headless && type == DrawI.class);
+            }
+        }
+        return anyNoop;
+    }
+
+    /** MDTX: after prepareSkip(): if the next instruction does nothing, advances the counter exactly as runOnce() would and returns true. */
+    public boolean skipNoop(){
+        double c = counter.numval;
+        if(c >= noop.length || c < 0) c = 0;
+        if(c < noop.length && noop[(int)c]){
+            counter.isobj = false;
+            counter.numval = c + 1;
+            return true;
+        }
+        return false;
+    }
+
     /** Loads with a specified assembler. Resets all variables. */
     public void load(LAssembler builder){
         stop = false;
