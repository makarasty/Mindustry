From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MaKarastY <71918286+makarasty@users.noreply.github.com>
Date: Wed, 14 Oct 2026 16:18:51 +0300
Subject: [PATCH] FIX.S(NetServer): split hidden snapshots so fog maps with
 many units keep sending them

---
 core/src/mindustry/core/NetServer.java | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/src/mindustry/core/NetServer.java b/core/src/mindustry/core/NetServer.java
index 8f946684773db3a7d5cc12249b78d518fe81f23c..65f3433b3e236d78981a6724d898185d2402b5d7 100644
--- a/core/src/mindustry/core/NetServer.java
+++ b/core/src/mindustry/core/NetServer.java
@@ -1213,9 +1213,11 @@ public class NetServer implements ApplicationListener{
             sendEntitySnapshots(tempConnections, (short)sent, syncStream.toByteArray());
         }
 
-        if(hiddenIds.size > 0){
+        //MDTX: more than ~8000 ids overflow the 32 KB packet buffer and the packet silently stops being sent; ids are independent, so split them
+        int chunk = headless ? 250 : Integer.MAX_VALUE;
+        for(int i = 0; i < hiddenIds.size; i += chunk){
             var packet = new HiddenSnapshotCallPacket();
-            packet.ids = hiddenIds;
+            packet.ids = hiddenIds.size <= chunk ? hiddenIds : new IntSeq(true, hiddenIds.items, i, Math.min(chunk, hiddenIds.size - i));
             net.send(packet, tempConnections, false);
         }
     }
