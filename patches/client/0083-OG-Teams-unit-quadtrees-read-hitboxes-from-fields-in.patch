diff --git a/core/src/mindustry/entities/Units.java b/core/src/mindustry/entities/Units.java
index b6efc744fe0dbc03d0c879a3d8a6b0defc83cc25..2a861794582b9f4d57343ab429d2bb3c78b69cd8 100644
--- a/core/src/mindustry/entities/Units.java
+++ b/core/src/mindustry/entities/Units.java
@@ -2,6 +2,7 @@ package mindustry.entities;
 
 import arc.*;
 import arc.func.*;
+import arc.math.*;
 import arc.math.geom.*;
 import arc.struct.*;
 import arc.util.*;
@@ -459,7 +460,9 @@ public class Units{
     /** Iterates over all units in a circle around this position. */
     public static void nearby(@Nullable Team team, float x, float y, float radius, Cons<Unit> cons){
         nearby(team, x - radius, y - radius, radius*2f, radius*2f, unit -> {
-            if(unit.within(x, y, radius + unit.hitSize/2f)){
+            //same as unit.within(), without the megamorphic Position interface calls
+            float dst = radius + unit.hitSize/2f;
+            if(UnitTree.plain ? Mathf.dst2(unit.x, unit.y, x, y) < dst*dst : unit.within(x, y, dst)){
                 cons.get(unit);
             }
